{
    "name": "s-ichikawa/laravel-sendgrid-driver",
    "description": "This library adds a 'sendgrid' mail driver to Laravel.",
    "keywords": [
        "laravel",
        "sendgrid"
    ],
    "license": "MIT",
    "require": {
        "illuminate/mail": "^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/notifications": "^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/support": "^9.0||^10.0||^11.0||^12.0||^13.0",
        "guzzlehttp/guzzle": "^7.2 || ^8.0"
    },
    "require-dev": {
        "illuminate/container": "^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/filesystem": "^9.0||^10.0||^11.0||^12.0||^13.0",
        "phpunit/phpunit": "^10.5||^11.0||^12.0",
        "laravel/pint": "^1.13",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Sichikawa\\LaravelSendgridDriver\\": "src"
        }
    },
    "autoload-dev": {
        "files": [
            "tests/TestCase.php"
        ]
    },
    "authors": [
        {
            "name": "shingo.ichikawa",
            "email": "ichikawa.shingo.0829@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/s-ichikawa/laravel-sendgrid-driver/issues"
    },
    "suggest": {
        "s-ichikawa/sendgrid-api-builder": "support to build json for sendgrid api"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sichikawa\\LaravelSendgridDriver\\SendgridTransportServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
